GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# DATABASE_URL / VECTOR_DB_PATH / RAW_DIR / PROCESSED_DIR: leave unset. They
# default to paths anchored at the project root (see backend/config.py) so
# they work regardless of which directory the app is launched from. Only set
# them here if you deliberately want to point at a different location.
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
