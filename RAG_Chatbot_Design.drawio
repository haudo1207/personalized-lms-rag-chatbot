  <diagram name="Dashboard" id="Dashboard"><mxGraphModel dx="1030" dy="622" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="db_kpi_avg" value="KPI: Điểm Quiz trung bình&#xa;82.5%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="160" height="60" as="geometry"/></mxCell><mxCell id="db_kpi_tot" value="KPI: Tổng số câu hỏi đặt&#xa;42 câu hỏi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="160" height="60" as="geometry"/></mxCell><mxCell id="db_kpi_weak" value="Cảnh báo Lỗ hổng kiến thức&#xa;Chủ đề: SQL JOIN (Weak Score: 0.76)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="60" width="220" height="60" as="geometry"/></mxCell><mxCell id="db_chart_bar" value="Biểu đồ cột (Bar Chart)&#xa;Tần suất câu hỏi theo Chủ đề&#xa;- SQL JOIN: 18 câu&#xa;- Normalization: 12 câu&#xa;- Indexing: 6 câu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontColor=#263238;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="160" as="geometry"/></mxCell><mxCell id="db_chart_line" value="Biểu đồ đường (Line Chart)&#xa;Đường cong cải thiện điểm số Quiz&#xa;- Lần 1: 50% (Easy)&#xa;- Lần 2: 70% (Medium)&#xa;- Lần 3: 90% (Hard)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontColor=#263238;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="350" y="140" width="290" height="160" as="geometry"/></mxCell><mxCell id="db_rec_action" value="Đề xuất ôn tập thích ứng cá nhân hóa&#xa;- Chủ đề yếu: SQL JOIN (Học lực hiện tại: Intermediate)&#xa;- Gợi ý: Hãy đọc lại Slide chương 3 trang 12-15 về Left Join. Thực hành làm Quiz bài 2 độ khó Medium để nâng hạng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="580" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram>
  <diagram name="Deployment Evaluation" id="Deployment Evaluation"><mxGraphModel dx="1030" dy="622" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ev_ret" value="Retrieval Quality Metrics&#xa;- Recall@3&#xa;- Recall@10&#xa;- Mean Reciprocal Rank (MRR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="ev_gen" value="Generation Quality Metrics&#xa;- Tính trung thực (Faithfulness)&#xa;- Độ liên quan câu trả lời (Answer Relevance)&#xa;- Tính chính xác (Accuracy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#388E3C;fontColor=#1B5E20;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="ev_lat" value="Hiệu năng &amp; Độ trễ (Latency)&#xa;- Retrieval Time (&lt;500ms)&#xa;- Response Time (&lt;3s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1976D2;fontColor=#0D47A1;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="80" y="170" width="220" height="70" as="geometry"/></mxCell><mxCell id="ev_judge" value="LLM-as-a-Judge Framework&#xa;Sử dụng Gemini đánh giá không tham chiếu&#xa;tính trung thực chống ảo tưởng." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#F57C00;fontColor=#E65100;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="320" y="170" width="220" height="70" as="geometry"/></mxCell><mxCell id="ev_table" value="Bảng dữ liệu đánh giá thực nghiệm RAG&#xa;- Vector: Recall@3 = 72.4% | Faithfulness = 78.5% | Latency = 1.25s&#xa;- Hybrid: Recall@3 = 82.5% | Faithfulness = 82.3% | Latency = 1.38s&#xa;- Hybrid+Rerank: Recall@3 = 89.2% | Faithfulness = 96.4% | Latency = 1.62s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#78909C;fontColor=#263238;fontSize=9.5;" vertex="1" parent="1"><mxGeometry x="80" y="260" width="460" height="90" as="geometry"/></mxCell><mxCell id="ev_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#546E7A;dashed=1;fontSize=9;" edge="1" parent="1" source="ev_ret" target="ev_judge"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ev_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#546E7A;dashed=1;fontSize=9;" edge="1" parent="1" source="ev_gen" target="ev_judge"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
